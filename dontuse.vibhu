# ------------------------------------------------------------
# Notebook template
# ------------------------------------------------------------
def title_from_filename(stem: str) -> str:
    if stem.lower() == "exercises":
        return "Exercises"
    parts = stem.split("_")
    # "01_01_..." -> "01.01 ..."
    if len(parts) >= 3 and parts[0].isdigit() and parts[1].isdigit():
        prefix = f"{parts[0]}.{parts[1]}"
        rest = "_".join(parts[2:]).replace("_", " ")
        return f"{prefix} {rest}"
    # "01_Linear_Algebra" -> "01 Linear Algebra"
    if len(parts) >= 2 and parts[0].isdigit():
        rest = "_".join(parts[1:]).replace("_", " ")
        return f"{parts[0]} {rest}"
    return stem.replace("_", " ")


def notebook_json(title: str) -> dict:
    return {
        "cells": [
            {"cell_type": "markdown", "metadata": {}, "source": [f"# {title}\n"]},
            {
                "cell_type": "markdown",
                "metadata": {},
                "source": [
                    "## Notes\n",
                    "- Add theory, derivations, examples, and solved exercises here.\n",
                    "- Add references at the end.\n",
                ],
            },
            {
                "cell_type": "code",
                "execution_count": None,
                "metadata": {},
                "outputs": [],
                "source": [
                    "# Scratch cell\n",
                    "import numpy as np\n",
                ],
            },
        ],
        "metadata": {
            "kernelspec": {"display_name": "Python 3", "language": "python", "name": "python3"},
            "language_info": {"name": "python", "version": "3.x"},
        },
        "nbformat": 4,
        "nbformat_minor": 5,
    }


def create_notebook(path: Path, force: bool) -> str:
    """
    Returns: created | skipped | overwritten
    """
    path.parent.mkdir(parents=True, exist_ok=True)

    if path.exists() and not force:
        return "skipped"

    title = title_from_filename(path.stem)
    path.write_text(json.dumps(notebook_json(title), indent=2), encoding="utf-8")
    return "overwritten" if path.exists() and force else "created"


# ------------------------------------------------------------
# README generation
# ------------------------------------------------------------
def make_readme(root: Path) -> str:
    lines: list[str] = []
    lines.append("# Mathematics for Machine Learning\n")
    lines.append("\n")
    lines.append("## Table of Contents (Linked)\n")
    lines.append("\n")

    for chapter in STRUCTURE:
        folder = chapter["folder"]
        title = chapter["title"]

        folder_link = f"[`{folder}/`]({folder}/)"
        lines.append(f"### {title}\n")
        lines.append(f"**Folder:** {folder_link}\n")
        lines.append("\n")

        # Add chapter overview notebook link if it exists in chapter file list
        # Only Chapter 1 has a chapter-level notebook in this plan
        chapter_nb = None
        for f in chapter["files"]:
            if f.endswith(".ipynb") and f.startswith(folder.split('_')[0] + "_") and f.count("_") == 2:
                # e.g. 01_Linear_Algebra.ipynb
                chapter_nb = f
                break

        if chapter_nb:
            lines.append(f"**Chapter Notebook:** [`{chapter_nb}`]({folder}/{chapter_nb})\n")

        if chapter.get("include_exercises", False):
            lines.append(f"**Exercises:** [`Exercises.ipynb`]({folder}/Exercises.ipynb)\n")

        lines.append("\n")
        lines.append("| Section | Notebook |\n")
        lines.append("|---|---|\n")

        for f in chapter["files"]:
            if f == chapter_nb:
                continue  # don't list the chapter-level notebook inside the section table
            if f.lower() == "exercises.ipynb":
                continue

            # Create section label from filename: 01_01_... -> 01.01
            stem = Path(f).stem
            parts = stem.split("_")
            if len(parts) >= 2 and parts[0].isdigit() and parts[1].isdigit():
                section = f"{parts[0]}.{parts[1]}"
            else:
                section = stem.replace("_", " ")

            lines.append(f"| {section} | [`{f}`]({folder}/{f}) |\n")

        lines.append("\n---\n\n")

    return "".join(lines)


# ------------------------------------------------------------
# MAIN
# ------------------------------------------------------------
def main() -> None:
    parser = argparse.ArgumentParser(
        description="Recreate MML folder+notebook structure (no notebooks/ folder, no Part I/II) and generate readme.md"
    )
    parser.add_argument(
        "--clean",
        action="store_true",
        help="Delete existing chapter folders (01_..., 02_..., etc.) before recreating.",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="Overwrite notebooks if they already exist.",
    )
    args = parser.parse_args()

    root = Path(".").resolve()

    # Clean (delete) existing chapter folders
    if args.clean:
        for ch in STRUCTURE:
            folder_path = root / ch["folder"]
            if folder_path.exists() and folder_path.is_dir():
                shutil.rmtree(folder_path)
        # Also remove old notebooks folder if exists (your previous structure)
        old = root / "notebooks"
        if old.exists() and old.is_dir():
            shutil.rmtree(old)

    created = skipped = overwritten = 0

    # Create folders + notebooks
    for chapter in STRUCTURE:
        folder_path = root / chapter["folder"]
        folder_path.mkdir(parents=True, exist_ok=True)

        # Exercises
        if chapter.get("include_exercises", False):
            ex_path = folder_path / "Exercises.ipynb"
            status = create_notebook(ex_path, force=args.force)
            created += (status == "created")
            skipped += (status == "skipped")
            overwritten += (status == "overwritten")

        for f in chapter["files"]:
            nb_path = folder_path / f
            status = create_notebook(nb_path, force=args.force)
            created += (status == "created")
            skipped += (status == "skipped")
            overwritten += (status == "overwritten")

    # Write README (readme.md)
    readme_path = root / "readme.md"
    readme_path.write_text(make_readme(root), encoding="utf-8")

    print("\n✅ Done.")
    print(f"Root: {root}")
    print(f"Created notebooks: {created}")
    print(f"Skipped (already existed): {skipped}")
    print(f"Overwritten: {overwritten}")
    print("Generated: readme.md")


if __name__ == "__main__":
    main()
